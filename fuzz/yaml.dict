# Document and collection syntax
document_start="---\x0a"
document_end="...\x0a"
flow_sequence="[]"
flow_mapping="{}"
flow_entry=", "
mapping_value=": "
explicit_key="? "
block_entry="- "

# Scalars, comments, anchors, aliases, tags, and directives
single_quotes="''"
double_quotes="\"\""
literal_block="|\x0a  "
folded_block=">-\x0a  "
comment="# comment\x0a"
anchor="&anchor"
alias="*anchor"
merge_key="<<: "
yaml_directive="%YAML 1.2\x0a---\x0a"
tag_directive="%TAG !e! tag:example.com,2026:\x0a---\x0a"
local_tag="!local"
verbatim_tag="!<tag:yaml.org,2002:str>"

# Double-quoted escape paths
escaped_newline="\\n"
escaped_hex="\\x20"
escaped_unicode="\\u2028"
escaped_surrogate_pair="\\uD83D\\uDE00"
